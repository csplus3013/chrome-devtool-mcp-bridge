FROM node:22-slim

RUN apt-get update -q && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Pre-install chrome-devtools-mcp so `docker exec` starts instantly (no npx cold-start)
# Pin to a specific version to prevent silent breakage from upstream changes.
# v1.1.0+ exits on stdin EOF (see #2117) — handled by the Rust bridge fix (v17).
# If Chrome is unreachable and sessions keep dying, downgrade to 0.24.0 as fallback.
RUN npm install -g chrome-devtools-mcp@1.2.0

# Keep container alive — the AI agent spawns chrome-devtools-mcp via `docker exec -i`
CMD ["sleep", "infinity"]
